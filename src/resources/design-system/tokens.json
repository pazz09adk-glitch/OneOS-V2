{
  "schemaVersion": 2,
  "name": "one-os-ds-v2",
  "title": "OneOS V2 全端设计 Token",
  "description": "OneOS V2 全局规范 Token。视觉基底：Stripe Fintech Violet #533AFD + Linear 结构。支持 Light 与 Dark 全局双色模式及若依 (RuoYi) 框架动态主题色适配。",
  "version": "2.4.0",
  "updatedAt": "2026-07-23",
  "sources": [
    "src/resources/design-system/DESIGN.md",
    "src/common/oneos-app-shell/oneos-app-shell.css",
    "src/resources/design-system/oneos-ds-tokens.css"
  ],
  "platforms": ["web-pc", "web-mobile", "h5-field", "mp-weixin", "app-native"],
  "colorMode": "light-and-dark",
  "colors": {
    "primary": "#533AFD",
    "primaryHover": "#6346FF",
    "primaryFocus": "#4226E8",
    "primarySoft": "#E0E7FF",
    "primarySoftDark": "rgba(83, 58, 253, 0.18)",
    "light": {
      "canvas": "#F6F9FC",
      "surfaceCard": "#FFFFFF",
      "surfacePearl": "#F8FAFC",
      "surfaceStrong": "#F1F5F9",
      "hairline": "#E3E8EE",
      "hairlineStrong": "#D4D4D8",
      "ink": "#0A2540",
      "body": "#425466",
      "muted": "#627D98"
    },
    "dark": {
      "canvas": "#0A0B0D",
      "surfaceCard": "#121418",
      "surfacePearl": "#16181F",
      "surfaceStrong": "#1E222D",
      "hairline": "#23272F",
      "hairlineStrong": "#2D3748",
      "ink": "#F7FAFC",
      "body": "#A0AEC0",
      "muted": "#718096"
    },
    "success": "#10B981",
    "warning": "#D97706",
    "error": "#EF4444",
    "info": "#3B82F6",
    "onPrimary": "#FFFFFF"
  },
  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
    "fontMono": "\"JetBrains Mono\", SFMono-Regular, Consolas, monospace",
    "scale": {
      "xs": { "size": "12px", "lineHeight": 1.33 },
      "sm": { "size": "13px", "lineHeight": 1.4 },
      "base": { "size": "14px", "lineHeight": 1.5 },
      "lg": { "size": "16px", "lineHeight": 1.5 },
      "xl": { "size": "18px", "lineHeight": 1.4 },
      "xxl": { "size": "22px", "lineHeight": 1.3 }
    }
  },
  "radius": {
    "control": "8px",
    "card": "12px",
    "pill": "9999px"
  },
  "grid": {
    "boxSizing": "border-box",
    "bento": {
      "columns": "repeat(4, 1fr)",
      "gap": "16px"
    },
    "filterBar": {
      "columns": "repeat(auto-fill, minmax(200px, 1fr))",
      "gap": "16px 12px",
      "alignItems": "end"
    },
    "grid3": {
      "columns": "repeat(auto-fill, minmax(320px, 1fr))",
      "gap": "20px"
    },
    "grid4": {
      "columns": "repeat(auto-fill, minmax(260px, 1fr))",
      "gap": "16px"
    },
    "splitView": {
      "sidebarWidth": "340px",
      "main": "1fr",
      "gap": "16px"
    }
  }
}
